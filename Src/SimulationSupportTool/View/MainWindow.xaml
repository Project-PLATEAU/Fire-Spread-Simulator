<Window x:Class="SimulationSupportTool.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:properties="clr-namespace:SimulationSupportTool.Properties"
        xmlns:mvvm="clr-namespace:SimulationSupportTool.MVVM"
        xmlns:local="clr-namespace:SimulationSupportTool.View"
        mc:Ignorable="d"
        Title="{x:Static properties:Resources.WindowTitle}"
        Height="600"
        Width="1000"
        MinHeight="500"
        MinWidth="900"
        Closing="Window_Closing"
        IsEnabled="{Binding IsInitializedWindow, Mode=OneWay}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 条件 -->
        <ScrollViewer x:Name="conditionScrollViewer"
                      Grid.Column="0">
            <StackPanel Margin="0,0,0,10">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSimulationRunning}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSimulationCompleated}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFirePointEditing}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="【シミュレーションデータの選択】"
                           Style="{StaticResource HeadingTextBlockStyle}"/>
                <Grid Margin="20,0,5,5"
                      IsEnabled="{Binding IsSimulationRangeEditing, Converter={StaticResource BooleanInverseConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             IsReadOnly="True"
                             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                             Text="{Binding InputSimulationSourceFolderPath, Mode=OneWay}"
                             Style="{StaticResource CommonTextBoxStyle}"/>
                    <Button Grid.Column="1"
                            Content="参照…"
                            Margin="5,0,0,0"
                            Style="{StaticResource CommonButtonStyle}"
                            Command="{Binding SelectInputFolderPathCommand}"/>
                </Grid>

                <TextBlock Text="【シミュレーション範囲の設定】"
                           Style="{StaticResource HeadingTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal"
                            Margin="20,0,5,5">
                    <Button Content="範囲指定"
                            Margin="0,0,5,0"
                            Style="{StaticResource CommonButtonStyle}"
                            Command="{Binding StartSimulationRangeEditingCommand}"/>
                    <Button Content="確定"
                            Margin="0,0,5,0"
                            Style="{StaticResource CommonButtonStyle}"
                            Command="{Binding ConfirmSimulationRangeEditingCommand}"/>
                    <Button Content="キャンセル"
                            Style="{StaticResource CommonButtonStyle}"
                            Command="{Binding CancelSimulationRangeEditingCommand}"/>
                </StackPanel>

                <TextBlock Text="【出火点の設定】"
                           Style="{StaticResource HeadingTextBlockStyle}"/>
                <StackPanel Margin="20,0,5,5"
                            IsEnabled="{Binding IsSimulationRangeEditing, Converter={StaticResource BooleanInverseConverter}}">
                    <TextBlock RenderTransformOrigin="0.5,0.5">
                        <Run BaselineAlignment="Center">※地図上の</Run>
                        <Image Width="16" Height="16" Source="/Resources/images/firepoint_icon.png"/>
                        <Run BaselineAlignment="Center">ボタンから設定</Run>
                    </TextBlock>
                    <DataGrid x:Name="firePointDataGrid"
                              ItemsSource="{Binding FirePointList, Mode=TwoWay}"
                              Style="{StaticResource CommonDataGridStyle}">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="番号"
                                                Width="30"
                                                Binding="{Binding No, Mode=OneWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Margin" Value="5"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="出火時間[分]&#10;(0～2939分)"
                                                    Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="2"
                                                 MaxLength="4"
                                                 Text="{Binding StartMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource NumberTextBoxStyle}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="TextChanged">
                                                    <i:InvokeCommandAction Command="{Binding StartMinutesChangedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.SimulationTimeTotalMinutes}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="階数[階]"
                                                    Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Width="50"
                                                  VerticalAlignment="Center"
                                                  ItemsSource="{Binding StoryList, Mode=OneWay}"
                                                  SelectedItem="{Binding SelectedStory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StoryList.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="削除"
                                                    Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="削除"
                                                Style="{StaticResource GridButtonStyle}"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.DeleteFirePointCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding FirePointListErrorMessage, Mode=OneWay}"
                               Style="{StaticResource ErrorMessageTextBlockStyle}"/>
                </StackPanel>

                <TextBlock Text="【シミュレーション時間の設定】"
                           Style="{StaticResource HeadingTextBlockStyle}"/>
                <StackPanel Margin="20,0,5,5"
                            IsEnabled="{Binding IsSimulationRangeEditing, Converter={StaticResource BooleanInverseConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="30"
                                 MaxLength="2"
                                 Text="{Binding SimulationTimeHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NumberTextBoxStyle}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="TextChanged">
                                    <i:InvokeCommandAction Command="{Binding SimulationTimeChangedCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <TextBlock Text="時間"
                                   VerticalAlignment="Center"
                                   Margin="5,0"/>

                        <TextBox Width="30"
                                 MaxLength="2"
                                 Text="{Binding SimulationTimeMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NumberTextBoxStyle}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="TextChanged">
                                    <i:InvokeCommandAction Command="{Binding SimulationTimeChangedCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <TextBlock Text="分（最大48時間59分）"
                                   VerticalAlignment="Center"
                                   Margin="5.0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SimulationTimeErrorMessage, Mode=OneWay}"
                               Style="{StaticResource ErrorMessageTextBlockStyle}"/>
                </StackPanel>

                <TextBlock Text="【風向・風速の設定】"
                           Style="{StaticResource HeadingTextBlockStyle}"/>
                <StackPanel Margin="20,0,5,5"
                            IsEnabled="{Binding IsSimulationRangeEditing, Converter={StaticResource BooleanInverseConverter}}">
                    <DataGrid x:Name="windConditionDataGrid"
                              ItemsSource="{Binding WindConditionList, Mode=TwoWay}"
                              Style="{StaticResource CommonDataGridStyle}">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="番号"
                                                    Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Visibility="{Binding No, Converter={StaticResource NotEqualsIntToVisibilityConverter}, ConverterParameter=0}"
                                                   Margin="5"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Text="{Binding No, Mode=OneWay}">
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="時間[分]&#10;(0～2939分)"
                                                    Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Visibility="{Binding No, Converter={StaticResource NotEqualsIntToVisibilityConverter}, ConverterParameter=0}"
                                                 Margin="2"
                                                 MaxLength="4"
                                                 Text="{Binding StartMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource NumberTextBoxStyle}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="TextChanged">
                                                    <i:InvokeCommandAction Command="{Binding StartMinutesChangedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.SimulationTimeTotalMinutes}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="風向[°]&#10;(0～359.9°)" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding No, Converter={StaticResource NotEqualsIntToVisibilityConverter}, ConverterParameter=0}">
                                            <TextBox x:Name="windDirectionTextBox"
                                                     Margin="2"
                                                     MaxLength="5"
                                                     Style="{StaticResource NumberTextBoxStyle}">
                                                <TextBox.Text>
                                                    <Binding Path="WindDirection" UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <mvvm:NumberValidationRule Min="0" Max="359.9"/>
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="TextChanged">
                                                        <i:InvokeCommandAction Command="{Binding WindDirectionChangedCommand}" CommandParameter="{Binding ElementName=windDirectionTextBox, Path=(Validation.HasError)}"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Button Content="設定"
                                                    Margin="5,0,0,0"
                                                    Style="{StaticResource GridButtonStyle}"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.OpenWindDirectionSettingDialogCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="風速[m/s]&#10;(0～25.0m/s)" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox x:Name="windSpeedTextBox"
                                                 Visibility="{Binding No, Converter={StaticResource NotEqualsIntToVisibilityConverter}, ConverterParameter=0}"
                                                 Margin="2"
                                                 MaxLength="4"
                                                 Style="{StaticResource NumberTextBoxStyle}">
                                            <TextBox.Text>
                                                <Binding Path="WindSpeed" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <mvvm:NumberValidationRule Min="0" Max="25.0"/>
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="TextChanged">
                                                    <i:InvokeCommandAction Command="{Binding WindSpeedChangedCommand}" CommandParameter="{Binding ElementName=windSpeedTextBox, Path=(Validation.HasError)}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="追加・削除" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Button Content="削除"
                                                    Visibility="{Binding No, Converter={StaticResource NotEqualsIntToVisibilityConverter}, ConverterParameter=0}"
                                                    Style="{StaticResource GridButtonStyle}"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.DeleteWindConditionCommand}"
                                                    CommandParameter="{Binding .}"/>

                                            <Button Content="追加"
                                                    Visibility="{Binding No, Converter={StaticResource EqualsIntToVisibilityConverter}, ConverterParameter=0}"
                                                    Style="{StaticResource GridButtonStyle}"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.AddWindConditionCommand}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding WindConditionListErrorMessage, Mode=OneWay}"
                               Style="{StaticResource ErrorMessageTextBlockStyle}"/>
                </StackPanel>

                <TextBlock Text="【出力GISデータの設定】"
                           Style="{StaticResource HeadingTextBlockStyle}"/>
                <StackPanel Margin="20,0,5,5"
                            IsEnabled="{Binding IsSimulationRangeEditing, Converter={StaticResource BooleanInverseConverter}}">
                    <CheckBox Content="KML（建物）"
                              Margin="0,0,0,5"
                              HorizontalAlignment="Left"
                              IsChecked="{Binding IsOutputKml, Mode=TwoWay}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,5">
                        <CheckBox x:Name="czmlCheckBox"
                                  Content="CZML"
                                  IsChecked="{Binding IsOutputCzml, Mode=TwoWay}"/>
                        <TextBlock Text="（"/>
                        <CheckBox Content="建物"
                                  IsEnabled="{Binding ElementName=czmlCheckBox, Path=IsChecked}"
                                  IsChecked="{Binding IsOutputCzmlBuilding, Mode=TwoWay}"/>
                        <CheckBox Content="延焼経路"
                                  Margin="10,0,0,0"
                                  IsEnabled="{Binding ElementName=czmlCheckBox, Path=IsChecked}"
                                  IsChecked="{Binding IsOutputCzmlFirePath, Mode=TwoWay}"/>
                        <TextBlock Text="）"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="20,0,0,5"
                                IsEnabled="{Binding ElementName=czmlCheckBox, Path=IsChecked}">
                        <TextBlock Text="高さ情報"/>
                        <RadioButton Content="標高" 
                                     GroupName="HeightType"
                                     Margin="10,0,0,0"/>
                        <RadioButton Content="楕円体高"
                                     GroupName="HeightType"
                                     Margin="10,0,0,0"
                                     IsChecked="{Binding IsEllipsoidHeight, Mode=TwoWay}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 IsReadOnly="True"
                                 Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                 Text="{Binding OutputGisDataFolderPath, Mode=OneWay}"
                                 Style="{StaticResource CommonTextBoxStyle}"/>
                        <Button Grid.Column="1"
                                Content="参照…"
                                Margin="5,0,0,0"
                                Style="{StaticResource CommonButtonStyle}"
                                Command="{Binding SelectOutputFolderPathCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding OutputSettingErrorMessage, Mode=OneWay}"
                               Style="{StaticResource ErrorMessageTextBlockStyle}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 地図 -->
        <wv2:WebView2CompositionControl x:Name="webView2"
                                        Grid.Column="1"/>

        <!-- シミュレーションボタン -->
        <Border Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,10,20"
                BorderBrush="LightGray"
                BorderThickness="1">
            <StackPanel Background="White">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSimulationRangeEditing}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFirePointEditing}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <StackPanel Width="165"
                            Margin="10">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSimulationRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSimulationCompleated}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Padding="10,2"
                            Command="{Binding StartSimulationCommand}">
                        <TextBlock Text="シミュレーション実行"
                                   FontSize="16"/>
                    </Button>

                </StackPanel>

                <Grid Width="200"
                      Height="100"
                      Margin="10"
                      Visibility="{Binding IsSimulationRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock FontSize="14"
                                   Text="{Binding ProgressMessage, Mode=OneWay}"/>
                        <TextBlock Margin="5"
                                   Text="{Binding ProgressSubMessage, Mode=OneWay}"/>
                    </StackPanel>
                    <Button Grid.Row="1"
                            Padding="10,2"
                            HorizontalAlignment="Right"
                            Command="{Binding CancelSimulationCommand}">
                        <TextBlock Text="中止"
                                   FontSize="16"/>
                    </Button>
                </Grid>

                <Grid Width="200"
                      Height="100"
                      Margin="10"
                      Visibility="{Binding IsSimulationCompleated, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               FontSize="14"
                               Text="{Binding ProgressMessage, Mode=OneWay}"/>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom">
                        <Hyperlink Command="{Binding OpenResultFolderCommand }">出力フォルダを開く</Hyperlink>
                    </TextBlock>

                    <Button Grid.Row="2"
                            Padding="10,2"
                            HorizontalAlignment="Right"
                            Command="{Binding FinishSimulationCommand}">
                        <TextBlock Text="終了"
                                   FontSize="16"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
