<UserControl x:Class="SimulationSourceFileCreator.View.ProgressControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SimulationSourceFileCreator.View"
             mc:Ignorable="d" 
             Height="150" 
             Width="400">
    <Border BorderBrush="Gray"
            BorderThickness="1"
            Background="White">
        <Grid>
            <Grid Margin="10,30,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0"
                             Height="20"
                             Minimum="0"
                             Maximum="{Binding ProgressMaxValue, Mode=OneWay}"
                             Value="{Binding ProgressValue, Mode=OneWay}">
                    <ProgressBar.Style>
                        <!-- 初期表示でグレーになるように設定 -->
                        <Style TargetType="ProgressBar">
                            <Setter Property="Foreground" Value="#FF06B025"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProgressMaxValue}" Value="0">
                                    <Setter Property="Foreground" Value="#FFE6E6E6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <StackPanel Grid.Row="1"
                            Margin="5">
                    <TextBlock FontSize="14"
                               Text="{Binding ProgressMessage, Mode=OneWay}"/>
                    <TextBlock Margin="5"
                               Text="{Binding ProgressSubMessage, Mode=OneWay}"/>
                </StackPanel>

                <Button Grid.Row="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Content="中止"
                        MinWidth="70"
                        Padding="10,2"
                        Margin="5,0,0,0"
                        Command="{Binding CancelCommand}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
