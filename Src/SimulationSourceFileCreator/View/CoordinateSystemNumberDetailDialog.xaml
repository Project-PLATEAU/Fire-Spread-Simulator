<Window x:Class="SimulationSourceFileCreator.View.CoordinateSystemNumberDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimulationSourceFileCreator.View"
        mc:Ignorable="d"
        Title="地域（平面直角座標系）の詳細"
        Height="600"
        Width="1000"
        MinHeight="500"
        MinWidth="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側（地域の選択） -->
        <Grid Grid.Column="0"
              Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,5">
                <TextBlock Text="地域の選択："
                           FontWeight="Bold"/>
                <TextBlock Text="変換したい３D都市モデルが該当する地域（平面直角座標系の系）を,下表から選択してください。"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding CoordinateSystemNumbers, Mode=TwoWay}"
                      Style="{StaticResource CommonDataGridStyle}"
                      Margin="5,0,0,0"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CommonDataGridColumnHeaderStyle}">
                        <Setter Property="Padding" Value="2"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="選択"
                                            Width="35">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center"
                                            Margin="2">
                                    <RadioButton GroupName="SeriesNumberRadioButton"
                                                 Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.SelectSeriesNumberCommand}"
                                                 CommandParameter="{Binding .}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource EqualsIntToBooleanMultiConverter}" Mode="OneWay">
                                                <Binding Path="DataContext.SelectedCoordinateSystemNumber" RelativeSource="{RelativeSource AncestorType=DataGrid}" Mode="OneWay"/>
                                                <Binding Path="SeriesNumber" Mode="OneWay"/>
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="系番号"
                                        Binding="{Binding DisplayNumber, Mode=OneWay}"
                                        Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="2"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="適用区域"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding TargetAreaDetails, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               Margin="2"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2" Margin="5,5,0,0">
                <TextBlock Text="※平成十四年国土交通省告示第九号の規定より抜粋"/>
                <Button Content="決定"
                        Style="{StaticResource CommonButtonStyle}"
                        HorizontalAlignment="Right"
                        Command="{Binding SelectCommand}"/>
            </Grid>
        </Grid>

        <!-- 右側（平面直角座標系とは） -->
        <Grid Grid.Column="1"
              Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="平面直角座標系とは："
                           FontWeight="Bold"/>
                <TextBlock Text="地図・地図地図システム上で正確な距離や面積・角度を計算するために,日本を19のエリアに分割したもの"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="5,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="・"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="丸い地球を無理やり一枚の平面地図にすると,どうしても「ひずみ（ズレ）」が生じてしまいます。"
                           TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="・"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="この「ひずみ」を実用上問題ないレベルまで抑えるため,日本を19のエリア（第1系〜第19系）に分けて,それぞれに最適な座標の基準を用意しています。"
                           TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="・"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="分割された各エリア内では,距離や面積,角度を非常に正確に計算することができます。"
                           TextWrapping="Wrap"/>
            </Grid>

            <Grid Grid.Row="2">
                <Viewbox Stretch="Uniform"
                         Margin="0,40,0,0">
                    <Image Source="/Resources/images/coordinate_system_map.png" Stretch="UniformToFill"/>
                </Viewbox>

                <Border BorderBrush="Black"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="10"
                        Width="200">
                    <StackPanel Margin="2">
                        <TextBlock Text="平面直角座標系"
                                   FontWeight="Bold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="・"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="数字は各系の番号"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="・"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="十字マークは各座標系の原点"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="・"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="図は「平成十四年国土交通省告示第九号」の規定をわかりやすく示したもので,一部不正確な可能性があります。"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    BorderBrush="Black"
                    BorderThickness="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="10">
                <StackPanel Margin="2">
                    <TextBlock Text="出典：国土地理院HP「わかりやすい平面直角座標系」"/>
                    <TextBlock Text="（https://www.gsi.go.jp/sokuchikijun/jpc.html）をもとに修正"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
