<UserControl x:Class="SimulationSourceFileCreator.View.GridTextControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SimulationSourceFileCreator.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="root">
    <Grid>
        <Border BorderBrush="Black"
                BorderThickness="1,1,0,0">
            <TextBlock Text="{Binding Text, ElementName=root}"
                       TextWrapping="Wrap"
                       Margin="{Binding TextMargin, ElementName=root}"
                       HorizontalAlignment="{Binding TextHorizontalAlignment, ElementName=root}"/>
        </Border>
    </Grid>
</UserControl>
