<Window x:Class="SimulationSourceFileCreator.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:SimulationSourceFileCreator.Properties"
        xmlns:local="clr-namespace:SimulationSourceFileCreator.View"
        mc:Ignorable="d"
        Title="{x:Static properties:Resources.WindowTitle}"
        Height="480"
        Width="560"
        MinHeight="480"
        MinWidth="560"
        MaxWidth="1000"
        SizeToContent="Height"
        Closing="Window_Closing">

    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <StackPanel x:Key="mainContent">
            <TextBlock Text="【入力フォルダ・ファイル選択】"
                       Style="{StaticResource HeadingTextBlockStyle}"/>

            <StackPanel Margin="20,0,5,5">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,5">

                    <RadioButton Content="フォルダ選択"
                                 GroupName="InputTypeSelect"
                                 IsChecked="{Binding IsInputTypeFolder, Mode=TwoWay}"/>
                    <RadioButton Content="ファイル選択"
                                 GroupName="InputTypeSelect"
                                 Margin="10,0,0,0"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             IsReadOnly="True"
                             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                             Text="{Binding InputFolderOrFilePath, Mode=OneWay}"
                             Style="{StaticResource CommonTextBoxStyle}"/>
                    <Button Grid.Column="1"
                            Content="参照…"
                            Margin="5,0,0,0"
                            Style="{StaticResource CommonButtonStyle}"
                            Command="{Binding SelectInputFolderOrFilePathCommand}"/>
                </Grid>
                <TextBlock Text="{Binding InputFolderOrFilePathErrorMessage}"
                           Style="{StaticResource ErrorMessageTextBlockStyle}"/>
            </StackPanel>

            <TextBlock Text="【地域の選択】"
                       Style="{StaticResource HeadingTextBlockStyle}"/>

            <StackPanel Margin="20,0,5,5">
                <TextBlock Text="変換したい３D都市モデルが該当する地域（平面直角座標系の系）を,選択してください。"
                           Margin="0,0,0,5"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,5">
                    <TextBlock Text="地域（平面直角座標系）："/>
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                        <Hyperlink Command="{Binding OpenCoordinateSystemNumberDetailDialogCommand }">詳細を確認して選択</Hyperlink>
                    </TextBlock>
                </StackPanel>
                <ComboBox ItemsSource="{Binding CoordinateSystemNumbers, Mode=OneWay}"
                          SelectedValuePath="SeriesNumber"
                          SelectedValue="{Binding SelectedCoordinateSystemNumber, Mode=TwoWay}"
                          Margin="0,0,0,5"
                          Width="490"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding DisplayNumber, Mode=OneWay}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text=": "/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding TargetArea, Mode=OneWay}"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="※上記プルダウンの地域はわかりやすくしたもので、正確性を欠く内容である可能性があります。"
                           TextWrapping="Wrap"/>
                <TextBlock Text="　正確な範囲は「詳細を確認して選択」から確認して下さい。"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Text="【木造建物の防火構造の選択】"
                       Style="{StaticResource HeadingTextBlockStyle}"/>

            <StackPanel Margin="20,0,5,5">
                <TextBlock Text="木造建物の防火構造の種類を「防火造」、「準防火造」、「裸木造」から選択してください。"
                           Margin="0,0,0,5"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="防火構造："
                               VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding FireproofStructureTypeDict, Mode=OneWay}"
                              SelectedValuePath="Key"
                              DisplayMemberPath="Value"
                              SelectedValue="{Binding SelectedFireproofStructureType, Mode=TwoWay}"
                              Width="75"/>
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0">
                        <Hyperlink Command="{Binding OpenFireproofStructureTypeDetailDialogCommand }">防火構造の詳細を確認</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="【出力フォルダ選択】"
                       Style="{StaticResource HeadingTextBlockStyle}"/>
            <StackPanel Margin="20,0,5,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             IsReadOnly="True"
                             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                             Text="{Binding OutputFolderPath, Mode=OneWay}"
                             Style="{StaticResource CommonTextBoxStyle}"/>
                    <Button Grid.Column="1"
                            Content="参照…"
                            Margin="5,0,0,0"
                            Style="{StaticResource CommonButtonStyle}"
                            Command="{Binding SelectOutputFolderPathCommand}"/>
                </Grid>
                <TextBlock Text="{Binding OutputFolderPathErrorMessage}"
                           Style="{StaticResource ErrorMessageTextBlockStyle}"/>
            </StackPanel>

        </StackPanel>

        <StackPanel x:Key="advancedContent">
            <TextBlock Text="防火構造は以下の手順で手動で編集し、シミュレーション用データへの反映が可能です。"
                       Margin="0,0,0,5"/>

            <TextBlock Text="1.【中間CSVファイルの出力】"
                       FontWeight="Bold"/>

            <Grid Margin="20,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="指定のフォルダ・ファイルの3D都市モデルを使用して中間CSVファイルを出力します。"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="出力"
                        Style="{StaticResource CommonButtonStyle}"
                        HorizontalAlignment="Right"
                        Command="{Binding StartConvertCommand}"
                        CommandParameter="{x:Static local:ConvertType.ToCSV}"/>
            </Grid>

            <TextBlock Text="2.【中間CSVファイルの編集】"
                       FontWeight="Bold"/>

            <StackPanel Margin="20,0,0,5">
                <TextBlock Text="出力された中間CSVファイルを操作マニュアルの手順に従って修正してください。"
                           TextWrapping="Wrap"/>
                <Grid Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             IsReadOnly="True"
                             Background="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}"
                             Text="{Binding OutputCSVFolderPath, Mode=OneWay}"
                             Style="{StaticResource CommonTextBoxStyle}"
                             Margin="0,0,5,0"/>
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0">
                        <Hyperlink Command="{Binding OpenCSVFolderCommand }" Cursor="">フォルダを開く</Hyperlink>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <TextBlock Text="3.【変換の実行】"
                       FontWeight="Bold"/>

            <Grid Margin="20,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="中間CSVファイルを使用して指定の出力フォルダにシミュレーション用データを出力します。"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="変換"
                        Style="{StaticResource CommonButtonStyle}"
                        HorizontalAlignment="Right"
                        Command="{Binding StartConvertCommand}"
                        CommandParameter="{x:Static local:ConvertType.FromCSV}"/>
            </Grid>
        </StackPanel>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel IsEnabled="{Binding IsConverting, Mode=OneWay, Converter={StaticResource BooleanInverseConverter}}">
                <!-- メインの内容 -->
                <ContentControl Content="{StaticResource mainContent}"/>

                <!-- 変換ボタン -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"
                            >

                    <Button MinWidth="70"
                            Padding="10,2"
                            IsEnabled="{Binding ElementName=advancedConvertCheckBox, Path=IsChecked, Converter={StaticResource BooleanInverseConverter}}"
                            Command="{Binding StartConvertCommand}"
                            CommandParameter="{x:Static local:ConvertType.All}">
                        <TextBlock Text="変換"
                               FontSize="16"/>
                    </Button>

                    <CheckBox x:Name="advancedConvertCheckBox"
                              Content="高度な変換"
                              VerticalAlignment="Center"
                              Margin="10,0,0,0"
                              IsChecked="False"/>
                </StackPanel>

                <!-- 高度な変換の内容 -->
                <StackPanel Margin="10,5,10,10"
                            Background="Beige"
                            HorizontalAlignment="Center">
                    <ContentControl Content="{StaticResource advancedContent}"
                                    HorizontalAlignment="Center"
                                    Margin="10"
                                    Visibility="{Binding ElementName=advancedConvertCheckBox, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsConverting, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:ProgressControl DataContext="{Binding ProgressControlViewModel, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</Window>
