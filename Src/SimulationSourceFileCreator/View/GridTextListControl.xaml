<UserControl x:Class="SimulationSourceFileCreator.View.GridTextListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SimulationSourceFileCreator.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="root">
    <Grid>
        <Border BorderBrush="Black"
                BorderThickness="1,1,0,0">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 1行目 -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="・"/>
                <TextBlock  Grid.Row="0" Grid.Column="1"
                            TextWrapping="Wrap">
                    <Run Text="{Binding Text1BeforeBold, ElementName=root}" FontWeight="Bold" TextDecorations="Underline"/>
                    <Run Text="{Binding Text1, ElementName=root}"/>
                    <Run Text="{Binding Text1AfterBold, ElementName=root}" FontWeight="Bold" TextDecorations="Underline"/>
                </TextBlock>

                <!-- 2行目 -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="・"
                           Visibility="{Binding Text2, ElementName=root, Converter={StaticResource NotNullStringToVisibilityConverter}}"/>

                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding Text2, ElementName=root}"
                           TextWrapping="Wrap"
                           Visibility="{Binding Text2, ElementName=root, Converter={StaticResource NotNullStringToVisibilityConverter}}"/>

                <!-- 3行目 -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="・"
                           Visibility="{Binding Text3, ElementName=root, Converter={StaticResource NotNullStringToVisibilityConverter}}"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding Text3, ElementName=root}"
                           TextWrapping="Wrap"
                           Visibility="{Binding Text3, ElementName=root, Converter={StaticResource NotNullStringToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
